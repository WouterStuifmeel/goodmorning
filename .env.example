# Copy to .env and fill in what you need. Nothing here is required for the
# mock-only pipeline (the current default) - everything has a working default.
# Real values become necessary once you switch a provider to "openai".

# --- Paths (defaults are fine for local dev; set explicitly in deployment) ---
# GOODMORNING_OUTPUT_DIR=./output
# GOODMORNING_DB_PATH=./data/jobs.sqlite3

# --- Presenter ---
# GOODMORNING_PRESENTER_VOICE=alloy
# GOODMORNING_DELIVERY_INSTRUCTIONS=Warm, calm morning-radio delivery...
# GOODMORNING_MUSIC_BED_FILE=./assets/music/bed.mp3

# --- Provider selection ---
# GOODMORNING_NEWS_PROVIDER=mock      # mock (default) or rss (config/feeds.json, free, live)
# GOODMORNING_SCRIPT_PROVIDER=mock    # mock (default) or openai (paid)
# GOODMORNING_TTS_PROVIDER=mock       # mock only for now

# --- Required once script_provider or tts_provider is set to "openai" ---
# GOODMORNING_OPENAI_API_KEY=sk-...
# GOODMORNING_OPENAI_SCRIPT_MODEL=gpt-4o-mini
# GOODMORNING_OPENAI_REQUEST_TIMEOUT_SECONDS=30
# GOODMORNING_OPENAI_MAX_RETRIES=2
